{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oel.fswdk.work_order.v1",
  "type": "object",
  "required": ["schema", "status", "candidate", "operation", "requested_output_dir", "constraints", "work_order_id"],
  "properties": {
    "schema": {"const": "oel.fswdk.work_order.v1"},
    "status": {"const": "ready"},
    "candidate": {"type": "object"},
    "operation": {"enum": ["validate", "test", "simulate", "bench", "qualify", "package"]},
    "requested_output_dir": {"type": "string", "minLength": 1},
    "constraints": {
      "type": "object",
      "required": ["deterministic", "workers", "network", "hosted_ai", "new_output_required"],
      "properties": {
        "deterministic": {"const": true},
        "workers": {"const": 1},
        "network": {"const": false},
        "hosted_ai": {"const": false},
        "new_output_required": {"const": true}
      },
      "additionalProperties": false
    },
    "work_order_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
