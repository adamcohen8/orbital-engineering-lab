{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbital-engineering-lab.vercel.app/schemas/oel-onp-handoff-packet-v1.schema.json",
  "title": "OEL Scale ONP Handoff Packet v1",
  "type": "object",
  "required": ["schema_id", "schema_version", "packet_id", "status", "objects", "source_screening", "handoff_case", "execution", "non_claims"],
  "properties": {
    "schema_id": {"const": "oel-onp-handoff-packet-v1"}, "schema_version": {"const": 1},
    "packet_id": {"type": "string", "minLength": 1}, "status": {"const": "planned"},
    "objects": {"type": "object"}, "source_screening": {"type": "object"},
    "handoff_case": {
      "type": "object", "required": ["canonical_propagator_family", "propagator_name", "force_model_profile"],
      "properties": {"canonical_propagator_family": {"const": "ONP"}, "propagator_name": {"const": "ONP"}, "force_model_profile": {"type": "string", "minLength": 1}}
    },
    "execution": {"type": "object"}, "non_claims": {"type": "array", "minItems": 1}
  }
}
