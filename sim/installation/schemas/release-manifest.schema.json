{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oel.example/schemas/release-manifest.schema.json",
  "title": "OEL Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "edition", "version", "channel", "published_at", "artifacts", "platforms", "python", "profiles", "contracts"],
  "properties": {
    "schema_version": {"const": "oel.release-manifest.v1"},
    "product": {"enum": ["orbital-engagement-lab", "orbital-engineering-lab"]},
    "edition": {"enum": ["public", "pro"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[-+][0-9A-Za-z.-]+)?$"},
    "source_commit": {"type": ["string", "null"]},
    "channel": {"enum": ["stable", "preview"]},
    "published_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "bytes", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"type": "string"},
          "platform": {"type": "string"},
          "architecture": {"type": "string"}
        },
        "anyOf": [{"required": ["path"]}, {"required": ["url"]}]
      }
    },
    "platforms": {"type": "array", "items": {"type": "string"}},
    "architecture": {"type": "string", "minLength": 1},
    "python": {"type": "object"},
    "profiles": {"type": "array", "items": {"type": "string"}},
    "contracts": {"type": "object"},
    "constraints": {"type": "object"},
    "minimum_launcher_version": {"type": "string"},
    "release_notes": {"type": "string"},
    "claims": {"type": "array", "items": {"type": "string"}},
    "non_claims": {"type": "array", "items": {"type": "string"}},
    "license": {"type": "object"},
    "supply_chain": {
      "type": "object",
      "properties": {
        "installation_integrity": {"$ref": "#/$defs/installationIntegrity"}
      }
    },
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "value"],
      "properties": {
        "alg": {"const": "RS256"},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "hashRow": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "install_path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "executable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "installationIntegrity": {
      "oneOf": [
        {"$ref": "#/$defs/expandedInstallationIntegrity"},
        {
          "type": "object",
          "required": ["schema_version", "bytes", "sha256", "data"],
          "properties": {
            "schema_version": {"const": "oel.installation-integrity.xz.v1"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "data": {"type": "string", "minLength": 4, "maxLength": 4194304, "pattern": "^[A-Za-z0-9+/]*={0,2}$"}
          },
          "additionalProperties": false
        }
      ]
    },
    "expandedInstallationIntegrity": {
      "type": "object",
      "required": ["schema_version", "profile", "source", "runtime", "runtime_profiles", "digest"],
      "properties": {
        "schema_version": {"const": "oel.installation-integrity.v1"},
        "profile": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {
          "type": "object",
          "required": ["schema_version", "exclusions", "files", "digest"],
          "properties": {
            "schema_version": {"const": "oel.source-inventory.v1"},
            "exclusions": {"type": "object"},
            "files": {"type": "array", "items": {"$ref": "#/$defs/hashRow"}},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "required": ["schema_version", "wheels", "layout", "digest"],
          "properties": {
            "schema_version": {"const": "oel.runtime-inventory.v1"},
            "profile": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "wheels": {"type": "array", "items": {"type": "object"}},
            "layout": {"type": "object"}
          },
          "additionalProperties": false
        },
        "runtime_profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/runtimeInventory"}
        }
      },
      "additionalProperties": false
    },
    "runtimeInventory": {
      "type": "object",
      "required": ["schema_version", "profile", "wheels", "layout", "digest"],
      "properties": {
        "schema_version": {"const": "oel.runtime-inventory.v1"},
        "profile": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "wheels": {"type": "array", "items": {"type": "object"}},
        "layout": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
